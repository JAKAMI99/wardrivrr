[Unit]
Description=wardrivrr Docker stack (api + postgis + optional valhalla)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Edit WorkingDirectory / Exec* paths to match the clone location.
WorkingDirectory=/opt/wardrivrr
Environment=FORCE_LOCAL_BUILD=1
ExecStart=/bin/bash /opt/wardrivrr/run.sh
ExecStop=/usr/bin/docker compose -f /opt/wardrivrr/docker-compose.yml -f /opt/wardrivrr/deploy/compose.car.yml --env-file /opt/wardrivrr/.env stop
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
