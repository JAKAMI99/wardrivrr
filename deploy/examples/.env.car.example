# Copy to repo root as .env (gitignored) before car_setup / compose
DB_HOST=postgis
DB_PORT=5432
DB_NAME=wardriving
DB_USER=explorer
DB_PASS=change_me_strong

# Host-network API → Valhalla on localhost
VALHALLA_URL=http://127.0.0.1:8002
VALHALLA_TILE_URL=
# Written by car_up / car_setup (paths on the mini-PC for docker.sock helpers)
# HOST_PROJECT=/home/jakami/code/wardrivrr
# HOST_DATA_ROOT=/home/jakami/code/wardrivrr/data
# WARDRIVRR_COMPOSE_ROOT=/host/project

# Host-network API uses localhost for gpsd + Kismet
GPSD_HOST=127.0.0.1
GPSD_PORT=2947
GPSD_ENABLED=1
# Poll gpsd at 5 Hz (wardrivrr reads the receiver via gpsd, not a separate stack)
GPSD_POLL_INTERVAL=0.2
# Expected serial path (Status shows if missing until you plug it in)
GPSD_DEVICE=/dev/ttyACM0
# Optional: pin fixes to one user id; else all users with navigation_active
# GPSD_USER_ID=1

# Road snap for Drive icon + fog unlock (rail / GPS lag)
GPS_SNAP_THRESHOLD_M=8
GPS_SNAP_ENABLED=1

KISMET_URL=http://127.0.0.1:2501
KISMET_USER=wardrivrr
KISMET_PASSWORD=change_me_kismet
KISMET_LIVE=1

JWT_SECRET_KEY=change_me_long_random
WARDRIVRR_MODE=full
ACHIEVEMENTS_TZ=Europe/Berlin
STATS_TZ=Europe/Berlin

# GitHub Actions → GHCR (replace OWNER). car_up.sh pulls this first.
WARDRIVRR_IMAGE=ghcr.io/OWNER/wardrivrr:latest
# FORCE_LOCAL_BUILD=1
