DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=wardriving
DB_USER=explorer
DB_PASS=change_me_strong

VALHALLA_URL=http://127.0.0.1:8002
# Absolute host paths — MUST match the clone directory (./deploy.sh / ./run.sh
# overwrite these). Wrong paths break Valhalla docker-from-docker mid-drive.
# Example only; do not copy literally unless the repo lives at /opt/wardrivrr.
HOST_PROJECT=/path/to/wardrivrr
HOST_DATA_ROOT=/path/to/wardrivrr/data
WARDRIVRR_COMPOSE_ROOT=/path/to/wardrivrr

GPSD_HOST=127.0.0.1
GPSD_PORT=2947
GPSD_ENABLED=1
GPSD_POLL_INTERVAL=0.2
GPSD_DEVICE=/dev/ttyACM0
# Parked overnight: pause fog unlock / drive XP / Kismet sample inserts unless
# the receiver moves ~100 m within 5 min (GPS jitter alone does not count).
# GPSD_STATIONARY_PAUSE=1
# GPSD_STATIONARY_WINDOW_S=300
# GPSD_STATIONARY_MIN_MOVE_M=100

GPS_SNAP_THRESHOLD_M=8
GPS_SNAP_ENABLED=1

KISMET_URL=http://127.0.0.1:2501
KISMET_USER=wardrivrr
KISMET_PASSWORD=change_me_kismet
KISMET_LIVE=1

# Leave unset to auto-generate into data/.jwt_secret on first API start.
# JWT_SECRET_KEY=
WARDRIVRR_MODE=full
ACHIEVEMENTS_TZ=Europe/Berlin
STATS_TZ=Europe/Berlin

WARDRIVRR_IMAGE=wardrivrr-api:local
FORCE_LOCAL_BUILD=1
# Or GHCR: WARDRIVRR_IMAGE=ghcr.io/OWNER/wardrivrr:latest
