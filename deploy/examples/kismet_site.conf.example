# Generated by scripts/car_setup.sh — example only
server_name=wardrivrr
gps=gpsd:host=127.0.0.1,port=2947

# Replace wlanX / hciX after setup prompts
source=wlan1:name=AlfaMonitor:type=linuxwifi
source=hci0:name=Bluetooth:type=linuxbluetooth

log_prefix=/home/kismet/logs/wardrivrr
log_types=kismet,kis_db
log_title_timestamp=true
