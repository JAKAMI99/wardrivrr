DB_HOST=localhost
DB_PORT=5432
DB_NAME=wardriving
DB_USER=explorer
DB_PASS=secure_password_here

# Car / Docker API container uses service hostname:
# DB_HOST=postgis
VALHALLA_URL=http://127.0.0.1:8002

GPSD_HOST=127.0.0.1
GPSD_PORT=2947
GPSD_ENABLED=1
# API reads gpsd at this interval (seconds). Default 0.2 ≈ 5 Hz for smoother course.
GPSD_POLL_INTERVAL=0.2
# Optional pin: GPSD_USER_ID=1

# Snap GPS onto road_segments for icon + fog unlock (meters). Alias: SNAP_TO_ROAD_M
# Default 8; code hard-caps at 10 — good receiver, only rail/jitter forgiveness.
GPS_SNAP_THRESHOLD_M=8
GPS_SNAP_ENABLED=1
# Soft-prefer edges within this heading of travel (avoids rail / wrong parallel)
# GPS_SNAP_HEADING_PREF_DEG=55

KISMET_URL=http://127.0.0.1:2501
KISMET_USER=wardrivrr
KISMET_PASSWORD=changeme
KISMET_LIVE=1

WARDRIVRR_MODE=full
JWT_SECRET_KEY=change_me_in_production

# Prefer GitHub Actions image (set to your owner after first CI push):
# WARDRIVRR_IMAGE=ghcr.io/<owner>/wardrivrr:latest
# FORCE_LOCAL_BUILD=1   # scripts/car_up.sh: skip pull, build locally
