DB_HOST=localhost
DB_PORT=5432
DB_NAME=wardriving
DB_USER=explorer
DB_PASS=secure_password_here

# Docker API service uses: DB_HOST=postgis
VALHALLA_URL=http://127.0.0.1:8002
# VALHALLA_SERVER_THREADS=4

GPSD_HOST=127.0.0.1
GPSD_PORT=2947
GPSD_ENABLED=1
GPSD_POLL_INTERVAL=0.2
# Parked pause: unlock/XP/Kismet ingest stop when net motion in window < MIN_MOVE_M.
# GPSD_STATIONARY_PAUSE=1
# GPSD_STATIONARY_WINDOW_S=300
# GPSD_STATIONARY_MIN_MOVE_M=100

GPS_SNAP_THRESHOLD_M=8
GPS_SNAP_ENABLED=1

KISMET_URL=http://127.0.0.1:2501
KISMET_USER=wardrivrr
KISMET_PASSWORD=changeme
KISMET_LIVE=1

WARDRIVRR_MODE=full
# WARDRIVRR_VERSION=   # optional; defaults to VERSION file
# Leave unset to auto-generate a random secret into data/.jwt_secret on first start.
# Set explicitly only if you need the same secret across hosts / rebuilds.
# JWT_SECRET_KEY=

# Car overlay (deploy/compose.car.yml): absolute host paths required.
# ./run.sh / ./deploy.sh usually write these; set explicitly for manual compose.
# HOST_PROJECT=/opt/wardrivrr
# HOST_DATA_ROOT=/opt/wardrivrr/data
# Ensure host dirs exist for binds, e.g. mkdir -p data/kismet_logs data/valhalla data/incoming

# WARDRIVRR_IMAGE=ghcr.io/<owner>/wardrivrr:latest
# FORCE_LOCAL_BUILD=1
